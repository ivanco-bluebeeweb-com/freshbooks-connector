            "title": "Connection Id",
            "type": "string"
          },
          "account_id": {
            "default": "",
            "description": "Which FreshBooks business account to target, if the connection covers several. Omit to use the default account.",
            "title": "Account Id",
            "type": "string"
          },
          "limit": {
            "default": 100,
            "description": "Number of recent invoices to scan for the overview.",
            "maximum": 100,
            "minimum": 1,
