      "scopes": [],
      "owner_chat_tool": "freshbooks"
    },
    {
      "name": "create_entity",
      "description": "Create a new FreshBooks record of any writable resource type (clients, invoices, expenses, estimates, items) from a JSON object of its fields.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "freshbooks.entity.created"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "default": "",
