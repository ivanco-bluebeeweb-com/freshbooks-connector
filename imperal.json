{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "freshbooks-connector",
  "version": "0.1.0",
  "name": "FreshBooks",
  "description": "Connect your own FreshBooks account(s) (OAuth2) to manage clients, invoices, expenses, estimates, items, and payments -- full read/write plus value-add revenue overview and overdue-invoice reports.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "freshbooks:read",
    "freshbooks:write"
  ],
  "tools": [
    {
      "name": "connect_freshbooks",
      "description": "Start connecting your FreshBooks account(s): register your FreshBooks app's Client ID/Client Secret, then get back a one-time browser authorize_url. Open it, sign in with FreshBooks, pick the business(es) to grant access to, and approve -- FreshBooks redirects back here automatically and the connection finishes itself, no further action needed.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "freshbooks.connection.pending"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "client_id": {
            "default": "",
            "description": "Your FreshBooks app's Client ID (my.freshbooks.com/#/developer).",
            "title": "Client Id",
            "type": "string"
          },
          "client_secret": {
            "default": "",
            "description": "Your FreshBooks app's Client Secret.",
            "title": "Client Secret",
            "type": "string"
          },
          "redirect_uri": {
            "default": "",
            "description": "The redirect URI registered on your FreshBooks app.",
            "title": "Redirect Uri",
            "type": "string"
          },
          "label": {
            "default": "",
            "description": "Optional friendly label for this connection, e.g. 'Acme Inc FreshBooks'.",
            "title": "Label",
            "type": "string"
          }
        },
        "title": "ConnectFreshbooksParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "authorize_url": {
            "default": "",
            "title": "Authorize Url",
            "type": "string"
          },
          "pending_id": {
            "default": "",
            "title": "Pending Id",
            "type": "string"
          }
        },
        "title": "ConnectFreshbooksResult",
        "type": "object"
      },
      "event": "freshbooks-connector.connect",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "freshbooks"
    },
    {
      "name": "list_connections",
      "description": "List the connected FreshBooks accounts.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "description": "Explicit empty params model -- V17 disallows untyped handlers.",
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "ProviderAccount": {
            "properties": {
              "account_id": {
                "default": "",
                "title": "Account Id",
                "type": "string"
              },
              "name": {
                "default": "",
                "title": "Name",
                "type": "string"
              },
              "business_uuid": {
                "default": "",
                "title": "Business Uuid",
                "type": "string"
              }
            },
            "title": "ProviderAccount",
            "type": "object"
          },
          "ProviderConnection": {
            "properties": {
              "id": {
                "default": "",
                "title": "Id",
                "type": "string"
              },
              "label": {
                "default": "",
                "title": "Label",
                "type": "string"
              },
              "accounts": {
                "items": {
                  "$ref": "#/$defs/ProviderAccount"
                },
                "title": "Accounts",
                "type": "array"
              },
              "default_account_id": {
                "default": "",
                "title": "Default Account Id",
                "type": "string"
              }
            },
            "title": "ProviderConnection",
            "type": "object"
          }
        },
        "properties": {
          "connections": {
            "items": {
              "$ref": "#/$defs/ProviderConnection"
            },
            "title": "Connections",
            "type": "array"
          }
        },
        "title": "ProviderConnectionList",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "freshbooks"
    },
    {
      "name": "disconnect_freshbooks",
      "description": "Disconnect a FreshBooks connection: deletes the saved connection (and every account it covered). Nothing in FreshBooks itself is changed.",
      "action_type": "destructive",
      "chain_callable": true,
      "effects": [
        "freshbooks.connection.removed"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "description": "Which connection to disconnect (see list_connections).",
            "title": "Connection Id",
            "type": "string"
          }
        },
        "required": [
          "connection_id"
        ],
        "title": "DisconnectFreshbooksParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "deleted": {
            "default": false,
            "title": "Deleted",
            "type": "boolean"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          }
        },
        "title": "DeleteResult",
        "type": "object"
      },
      "event": "freshbooks-connector.disconnect",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "freshbooks"
    },
    {
      "name": "list_entities",
      "description": "List FreshBooks records of any resource type (clients, invoices, expenses, estimates, items, payments, taxes, staffs) in the connected FreshBooks account.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "description": "Which connected FreshBooks account grant to use (see list_connections). Omit if only one is connected.",
            "title": "Connection Id",
            "type": "string"
          },
          "account_id": {
            "default": "",
            "description": "Which FreshBooks business account to target, if the connection covers several. Omit to use the default account.",
            "title": "Account Id",
            "type": "string"
          },
          "entity": {
            "description": "Resource type: clients, invoices, expenses, estimates, items, payments, taxes, staffs.",
            "title": "Entity",
            "type": "string"
          },
          "page": {
            "default": 1,
            "description": "Page number, 1-based.",
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "per_page": {
            "default": 30,
            "description": "Records per page.",
            "maximum": 100,
            "minimum": 1,
            "title": "Per Page",
            "type": "integer"
          }
        },
        "required": [
          "entity"
        ],
        "title": "ListEntitiesParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "entity": {
            "default": "",
            "title": "Entity",
            "type": "string"
          },
          "count": {
            "default": 0,
            "title": "Count",
            "type": "integer"
          },
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Records",
            "type": "array"
          }
        },
        "title": "EntityList",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "freshbooks"
    },
