  "secrets": [
    {
      "name": "freshbooks_connections",
      "description": "JSON array of connected FreshBooks OAuth grants: client_id/client_secret (your own FreshBooks app), access_token, refresh_token, expiry timestamps, the list of granted accounts (account_id, name, business_uuid), default_account_id, and label. Managed through connect_freshbooks / disconnect_freshbooks -- you should not need to edit this directly.",
      "required": true,
      "write_mode": "both",
      "max_bytes": 65536,
      "scope": "user",
      "rotation_hint_days": 90
    },
    {
      "name": "freshbooks_pending",
      "description": "JSON array of in-flight FreshBooks OAuth connection attempts (client_id/client_secret captured at connect_freshbooks time, keyed by a pending id used as the OAuth `state`), consumed and removed by the callback webhook once the code-for-token exchange completes. write_mode='extension': only connector code writes this, never the Panel UI directly.",
      "required": false,
      "write_mode": "extension",
      "max_bytes": 16384,
      "scope": "user"
    }
  ],
