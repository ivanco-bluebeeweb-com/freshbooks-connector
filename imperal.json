    {
      "name": "get_revenue_overview",
      "description": "Value-add report: scan recent FreshBooks invoices and summarize total invoiced/paid/outstanding amounts, broken down by status.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
