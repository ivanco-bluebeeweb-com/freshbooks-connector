            "default": 0.0,
            "title": "Total Invoiced",
            "type": "number"
          },
          "total_paid": {
            "default": 0.0,
            "title": "Total Paid",
            "type": "number"
          },
          "total_outstanding": {
            "default": 0.0,
            "title": "Total Outstanding",
